# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.env*.local
!.env.example

# --- Glitch workspace (added by import) ---
# Base secret-hygiene ignores (stamped by the Glitch workspace scaffold).
# Reduces accidental staging of secret-NAMED files. It does NOT catch an in-file paste
# or anything already tracked — that needs the secret scan + pre-commit hook (spec §8.5).
*.key
*credentials*
client_secret*.json
*token*.json
.mcp.json
*.mcp.json
.mcp.local.json
.planning/
STATE.md

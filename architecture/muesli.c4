specification {
  element actor {
    style { shape person }
  }
  element system
  element component
}

model {
  actor user "User" {
    description "A person using Muesli"
  }

  system muesli "Muesli" {
    description "The Muesli Web App"

    component frontend "Next.js"
    component api "API Routes"
    component db "Postgres Database (optional)" {
      description "Used only when Google sign-in is turned on"
    }
  }

  system blob "Vercel Blob" {
    description "Stores recordings and notes"
  }

  system openai "OpenAI API" {
    component transcription "Transcription"
    component notes "Notes model"
  }

  system google "Google API (optional)" {
    description "Used only when GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set"
    component oauth "Google OAuth"
    component calendar "Google Calendar API"
  }

  user -> frontend "Interacts with"
  frontend -> api "API requests"
  frontend -> blob "Uploads recordings"
  frontend -> oauth "Authenticates via (optional)"
  api -> blob "Reads recordings, writes notes"
  api -> transcription "Transcribes audio"
  api -> notes "Writes notes"
  api -> db "Reads/Writes (optional)"
  api -> calendar "Fetches events (optional)"
}

views {
  view index {
    title "Muesli High-Level Architecture"
    include *
  }
}
